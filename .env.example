# Copy this file to .env and change values as needed.
PORT=3000

# Secret used to sign login cookies. Use any long random string, and never commit your real .env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Hosting: Neon pooled PostgreSQL URL. Keep the real value private.
# Required when NODE_ENV=production; omit for local SQLite development.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# NODE_ENV=production
